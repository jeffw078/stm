{
  "name": "steelmast-auditoria-5s",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:bootstrap": "node --import tsx scripts/bootstrap.ts",
    "import:history": "node --import tsx scripts/import-history.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run typecheck && npm test && npm run check:secrets",
    "dev:preview": "node --import tsx scripts/dev-preview.ts",
    "db:reset-master": "node --import tsx scripts/reset-master.ts",
    "pcm:dev": "next dev --hostname 0.0.0.0",
    "pcm:build": "next build",
    "pcm:test": "node --import tsx --test --test-concurrency=1 apps/pcm/tests/*.test.ts",
    "pcm:check": "npm run typecheck && npm run pcm:test && npm run check:secrets",
    "pcm:migrate": "node --import tsx apps/pcm/scripts/migrate.ts",
    "pcm:job": "node --import tsx apps/pcm/scripts/job.ts",
    "pcm:preview": "node --import tsx apps/pcm/scripts/dev-preview.ts",
    "pcm:test:e2e": "playwright test tests/e2e/pcm.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "csv-parse": "7.0.3",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
