# Server only. Never prefix these variables with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
APP_URL=http://localhost:3000
# Only used by npm run db:bootstrap. Choose a unique password (12+ characters).
MASTER_EMAIL=jeffersonw078@gmail.com
MASTER_TEMP_PASSWORD=
# PCM: durable private S3 storage (server only; required for production uploads).
PCM_STORAGE_BUCKET=
PCM_STORAGE_REGION=
PCM_STORAGE_ENDPOINT=
PCM_STORAGE_ACCESS_KEY_ID=
PCM_STORAGE_SECRET_ACCESS_KEY=
# Development only; defaults to data/private/pcm-files.
PCM_STORAGE_DIR=
# Authenticate the scheduler. Vercel Cron uses CRON_SECRET.
PCM_JOB_SECRET=
CRON_SECRET=
