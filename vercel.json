{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "env": {
    "APP_URL": "https://stm-dev.vercel.app"
  },
  "regions": [
    "iad1"
  ],
  "functions": {
    "app/api/**/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/pcm/jobs/run",
      "schedule": "0 9 * * *"
    }
  ]
}
